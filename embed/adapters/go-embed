#!/usr/bin/env python3
"""nift-go Nift Embed adapter (capability layer 2).

Consumes the nift-go binding (a thin cgo wrapper over the public C ABI):
JSON request on stdin -> JSON result on stdout, implementing the same neutral
protocol as the cpp-embed / rust-embed / c-abi adapters. The harness binary is
built from nift-embed/bindings/go/cmd/embed-harness when missing.
"""
import json
import os
import subprocess
import sys

GO_DIR = os.environ.get(
    "NIFT_GO_DIR", "/home/nick/Repositories/nift/nift-embed/bindings/go"
)
HARNESS = os.path.join(GO_DIR, "embed-harness")

if not os.path.exists(HARNESS):
    subprocess.run(
        ["go", "build", "-o", "embed-harness", "./cmd/embed-harness"],
        cwd=GO_DIR,
        check=True,
    )


def dash(value):
    return "-" if not value else value


req = json.load(sys.stdin)
args = [
    HARNESS,
    req["root"],
    dash(req.get("page")),
    dash(req.get("template")),
    dash(req.get("page_name")),
    dash(req.get("current_output")),
    dash(req.get("page_path")),
    dash(req.get("template_path")),
    req.get("mode", "composed"),
    req.get("seam", "-"),
]
bindings = req.get("bindings", {})
stdin_text = "".join(f"{name}={value}\n" for name, value in bindings.items())
proc = subprocess.run(args, input=stdin_text, capture_output=True, text=True)
if proc.stdout:
    sys.stdout.write(proc.stdout)
else:
    json.dump({"ok": False, "error": proc.stderr.strip()}, sys.stdout)
    sys.stdout.write("\n")
