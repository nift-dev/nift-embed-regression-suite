#!/usr/bin/env python3
"""Nift Python binding adapter (capability layer 2).

Consumes the Python binding (a CPython C extension over the public C ABI):
JSON request on stdin -> JSON result on stdout, implementing the same neutral
protocol as the other six adapters. The extension is built from
nift-embed/bindings/python via build.sh when missing.
"""
import json
import os
import subprocess
import sys

PYTHON_DIR = os.environ.get(
    "NIFT_PYTHON_DIR", "/home/nick/Repositories/nift/nift-embed/bindings/python"
)
HARNESS = os.path.join(PYTHON_DIR, "tests", "embed_harness.py")

if not any(f.startswith("_nift") for f in os.listdir(os.path.join(PYTHON_DIR, "nift"))):
    subprocess.run(["bash", "build.sh"], cwd=PYTHON_DIR, check=True)

req = json.load(sys.stdin)
proc = subprocess.run(["python3", HARNESS], input=json.dumps(req), capture_output=True, text=True)
if proc.stdout:
    sys.stdout.write(proc.stdout)
elif proc.returncode != 0:
    # Propagate the harness crash so the runner records it durably (a broken
    # adapter must never be swallowed into a JSON error with exit 0).
    json.dump({"ok": False, "error": proc.stderr.strip()}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(proc.returncode)
else:
    json.dump({"ok": False, "error": proc.stderr.strip()}, sys.stdout)
    sys.stdout.write("\n")
    sys.stdout.write("\n")
