#!/usr/bin/env python3
"""nift-rs Nift Embed adapter (capability layer 2).

Neutral protocol: one JSON request document on stdin -> one JSON result on
stdout. The request is implementation-neutral; only this adapter knows how to
invoke the nift-rs Embed harness. Override the harness path with RUST_HARNESS.

Request and result shapes match embed/README.md and adapters/cpp-embed.
"""
import json
import os
import subprocess
import sys

req = json.load(sys.stdin)
harness = os.environ.get("RUST_HARNESS")
if not harness:
    sys.stderr.write("RUST_HARNESS must point to the nift-rs engine_harness "
                     "(the independent experimental conformance implementation)\n")
    sys.exit(2)


def dash(value):
    return "-" if value in (None, "") else value


args = [
    harness,
    req["root"],
    dash(req.get("page")),
    dash(req.get("template")),
    dash(req.get("page_name")),
    dash(req.get("current_output")),
    dash(req.get("page_path")),
    dash(req.get("template_path")),
    req.get("mode", "composed"),
    req.get("seam", "-"),
]
bindings = req.get("bindings", {})
context_bindings = req.get("context_bindings", {})
lines = [f"{name}={value}" for name, value in bindings.items()]
lines += [f"@ctx {name}={value}" for name, value in context_bindings.items()]
stdin_text = "".join(f"{line}\n" for line in lines)

proc = subprocess.run(args, input=stdin_text, capture_output=True, text=True)
if not proc.stdout:
    json.dump({"ok": False, "error": proc.stderr.strip()}, sys.stdout)
    sys.stdout.write("\n")
    if proc.returncode != 0:
        sys.exit(proc.returncode)
    sys.stdout.write("\n")
    sys.exit(0)
try:
    result = json.loads(proc.stdout)
except json.JSONDecodeError:
    sys.stdout.write(proc.stdout)
    sys.exit(0)
# Neutralize loader keys to root-relative spellings so the result document is
# independent of where the case fixture was materialized.
root = req["root"]
keys = result.get("loaderKeys")
if isinstance(keys, list):
    prefix = root.rstrip("/\\") + "/"
    result["loaderKeys"] = [k[len(prefix):] if k.startswith(prefix) else k for k in keys]
json.dump(result, sys.stdout, ensure_ascii=False)
sys.stdout.write("\n")
