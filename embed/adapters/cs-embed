#!/usr/bin/env python3
"""Nift C# binding adapter (capability layer 2).

Consumes the C# binding (a P/Invoke wrapper over the public C ABI):
JSON request on stdin -> JSON result on stdout, implementing the same neutral
protocol as the cpp-embed / rust-embed / c-abi / go-embed adapters. The harness
is built from nift-embed/bindings/csharp/apps/NiftEmbedHarness when missing,
and libnift_c.so is copied beside it so DllImport can resolve it.
"""
import json
import os
import shutil
import subprocess
import sys

CSHARP_DIR = os.environ.get(
    "NIFT_CSHARP_DIR", "/home/nick/Repositories/nift/nift-embed/bindings/csharp"
)
HARNESS_DIR = os.path.join(CSHARP_DIR, "apps", "NiftEmbedHarness", "bin", "Debug", "net10.0")
HARNESS = os.path.join(HARNESS_DIR, "embed-harness")
NATIVE_LIB = os.environ.get("NIFT_C_ABI", "/home/nick/Repositories/nift/nift-embed/libnift_c.so")

if not os.path.exists(HARNESS):
    subprocess.run(
        ["dotnet", "build", "-v", "q", "--nologo"],
        cwd=os.path.join(CSHARP_DIR, "apps", "NiftEmbedHarness"),
        check=True,
    )

if os.path.exists(NATIVE_LIB) and not os.path.exists(os.path.join(HARNESS_DIR, "libnift_c.so")):
    shutil.copy(NATIVE_LIB, os.path.join(HARNESS_DIR, "libnift_c.so"))

req = json.load(sys.stdin)
proc = subprocess.run([HARNESS], input=json.dumps(req), capture_output=True, text=True)
if proc.stdout:
    sys.stdout.write(proc.stdout)
else:
    json.dump({"ok": False, "error": proc.stderr.strip()}, sys.stdout)
    sys.stdout.write("\n")
