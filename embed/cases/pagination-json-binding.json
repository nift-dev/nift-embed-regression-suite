{
  "name": "pagination-json-binding",
  "fixture": {
    ".nift/config.json": "{\"config\":{\"content-dir\":\"content/\",\"output-dir\":\"public/\",\"default-template\":\"templates/template.html\",\"incremental-mode\":\"modified\"}}",
    ".nift/tracked.json": "{\"tracked\":[{\"name\":\"blog\",\"title\":\"Blog\",\"template\":\"templates/template.html\",\"paginate\":{\"items-per-page\":1}}]}",
    "content/blog.html": "@item{one}@item{two}@paginate",
    "content/blog.paginate.html": "<section>$[site.name] page $[paginate.current]/$[paginate.total]</section>",
    "templates/template.html": "<main>$[title]</main>\n@content"
  },
  "request": {
    "page_name": "blog",
    "mode": "page",
    "bindings": {
      "site": "json:{\"name\":\"Acme\"}"
    }
  },
  "expected": {
    "ok": true,
    "output": "<main>Blog</main>\n<section>Acme page 1/2</section>",
    "dependencies": [
      "content/blog.html",
      "content/blog.paginate.html",
      "templates/template.html"
    ],
    "requirements": [],
    "pagination": [
      {
        "page": 2,
        "output": "<main>Blog</main>\n<section>Acme page 2/2</section>"
      }
    ]
  }
}
